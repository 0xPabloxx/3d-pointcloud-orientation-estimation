<mxGraphModel>
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    
    <!-- Title -->
    <mxCell id="title" value="MF Series: Mixture of von Mises" style="text;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
      <mxGeometry x="250" y="10" width="300" height="30" as="geometry" />
    </mxCell>
    
    <!-- Input: Point Cloud -->
    <mxCell id="input" value="Point Cloud
(B×N×3)" style="rounded=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="40" y="180" width="90" height="50" as="geometry" />
    </mxCell>
    
    <!-- PointNet++ Encoder -->
    <mxCell id="encoder" value="PointNet++
Encoder" style="rounded=1;fillColor=#BBDEFB;strokeColor=#1976D2;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="160" y="180" width="90" height="50" as="geometry" />
    </mxCell>
    
    <!-- MixturePeakHead -->
    <mxCell id="head" value="MixturePeak
Head" style="rounded=1;fillColor=#90CAF9;strokeColor=#1565C0;fontStyle=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="280" y="180" width="90" height="50" as="geometry" />
    </mxCell>
    
    <!-- Predicted (μ,κ) pairs - vertical -->
    <mxCell id="pred1" value="(μ₁, κ₁)" style="rounded=1;fillColor=#E1BEE7;strokeColor=#7B1FA2;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="400" y="80" width="60" height="28" as="geometry" />
    </mxCell>
    <mxCell id="pred2" value="(μ₂, κ₂)" style="rounded=1;fillColor=#E1BEE7;strokeColor=#7B1FA2;fontSize=10;" vertex="1" parent="1">
